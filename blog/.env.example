# Server
HOST=0.0.0.0
PORT=1337

# Secrets (generate with: openssl rand -base64 32)
# APP_KEYS is a comma-separated list of at least one key
APP_KEYS=changeme
ADMIN_JWT_SECRET=changeme
API_TOKEN_SALT=changeme
TRANSFER_TOKEN_SALT=changeme
# users-permissions JWT secret.
# IMPORTANT for v4 upgrades: if your v3 deployment relied on the hardcoded
# default in extensions/users-permissions/config/jwt.js
# (27c12e2a-6799-437d-b156-439e411db871), set that value here to keep
# existing tokens valid.
JWT_SECRET=changeme

# Database (MySQL)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Redis (GraphQL response cache + resolver cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# AWS S3 (strapi-provider-upload-mort)
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_REGION=
AWS_BUCKET=
