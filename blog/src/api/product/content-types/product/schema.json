{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "name": "product"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": false,
      "unique": true
    },
    "description": {
      "type": "text"
    },
    "dimensions": {
      "type": "string"
    },
    "price": {
      "type": "decimal",
      "required": false
    },
    "material": {
      "type": "enumeration",
      "enum": [
        "oak",
        "ash",
        "walnut",
        "other"
      ]
    },
    "availability": {
      "type": "enumeration",
      "enum": [
        "in_stock",
        "made_to_order",
        "unavailable"
      ]
    },
    "images": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": true,
      "required": false
    },
    "publicationDate": {
      "type": "datetime",
      "required": true
    }
  }
}
